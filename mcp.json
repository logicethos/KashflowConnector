{
  "mcpServers": {
    "kashflow": {
      "command": "${CURSOR_PLUGIN_ROOT}/scripts/kashflow-mcp",
      "env": {
        "KashFlow__UserName": "${KASHFLOW_USERNAME}",
        "KashFlow__Password": "${KASHFLOW_PASSWORD}",
        "KashFlow__MemorableWord": "${KASHFLOW_MEMORABLE_WORD}",
        "KashFlow__ReadOnly": "${KASHFLOW_READ_ONLY}"
      }
    }
  }
}
